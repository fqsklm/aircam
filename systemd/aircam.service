[Unit]
Description=AirCam fixed-wing USB camera controller
After=local-fs.target

[Service]
Type=simple
User=aircam
Group=aircam
SupplementaryGroups=video gpio dialout
RuntimeDirectory=aircam
RuntimeDirectoryMode=0750
WorkingDirectory=/run/aircam
ExecStart=/usr/bin/python3 /home/pi2/AirCam/aircam.py --config /home/pi2/AirCam/config/config.json --web /home/pi2/AirCam/web/index.html
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/home/pi2/AirCam/pictures

[Install]
WantedBy=multi-user.target
